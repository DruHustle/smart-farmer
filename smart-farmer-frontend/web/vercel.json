{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://api.farmer.onesa.eu/health"
    },
    {
      "source": "/ready",
      "destination": "https://api.farmer.onesa.eu/ready"
    },
    {
      "source": "/version",
      "destination": "https://api.farmer.onesa.eu/version"
    },
    {
      "source": "/v1",
      "destination": "https://api.farmer.onesa.eu/v1"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://api.farmer.onesa.eu/v1/:path*"
    },
    {
      "source": "/auth/onesa/callback",
      "destination": "/index.html"
    },
    {
      "source": "/auth/registration/complete",
      "destination": "/index.html"
    },
    {
      "source": "/account-deletion",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/auth/onesa/callback",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
