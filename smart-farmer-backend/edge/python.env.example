# Create a private environment file on the farm gateway. Never commit credentials.
EDGE_GATEWAY_ID=pi-farm-1
EDGE_SOURCE_IDS=pivot-1,pump-1,borehole-1
EDGE_INGRESS_TOKEN=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
EDGE_OUTBOUND_SECRET=CHANGE_ME_AN_INDEPENDENT_32_CHARACTER_RANDOM_SECRET
EDGE_API_URL=https://CHANGE_ME_SMART_FARMER_API_ORIGIN
EDGE_STATE_PATH=/var/lib/smart-farmer/edge.sqlite3
