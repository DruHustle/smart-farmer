# Copy to a protected gateway environment file. Never commit actual secrets.
# Package management currently verifies Node-RED 4.1.4; review its image/digest.
NODE_RED_IMAGE=CHANGE_ME_REVIEWED_NODE_RED_IMAGE_TAG_OR_DIGEST
NODE_RED_CREDENTIAL_SECRET=CHANGE_ME_RANDOM_AT_LEAST_32_CHARS
NODE_RED_ADMIN_USER=farm-admin
NODE_RED_ADMIN_PASSWORD_HASH=CHANGE_ME_BCRYPT_FROM_NODE_RED_ADMIN_HASH_PW
EDGE_INGRESS_TOKEN=CHANGE_ME_MATCH_EDGE_AGENT
# Optional package management. Leave BOTH empty until private-route enrollment.
# Retain this runtime UUID across API/gateway restarts; do not reuse across farms.
NODE_RED_RUNTIME_ID=
# Generate an independent 32-byte random value encoded as 64 hexadecimal characters.
NODE_RED_ADMIN_TOKEN=
