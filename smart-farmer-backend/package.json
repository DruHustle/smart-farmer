{
  "name": "smart-farmer-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node --import tsx src/migrate.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "worker": "node --import tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "test:integration": "node --import tsx --test test/api.test.ts test/core.test.ts test/integrations.test.ts",
    "test:backup": "node --import tsx --test test/backup.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
