# Copy to an owner-only private file, replace all placeholders and export before use.
FARMER_API_IMAGE=REPLACE_WITH_REVIEWED_API_IMAGE_AT_SHA256
FARMER_WEB_IMAGE=REPLACE_WITH_REVIEWED_WEB_IMAGE_AT_SHA256
# Required for the optional dedicated local database; build Dockerfile.database.
FARMER_DB_IMAGE=REPLACE_WITH_REVIEWED_DATABASE_IMAGE_AT_SHA256
FARMER_SOURCE_REVISION=REPLACE_WITH_EXACT_REVIEWED_COMMIT_SHA
FARMER_WEB_ORIGIN=https://farmer.onesa.eu
FARMER_RUNTIME_ENV_FILE=/etc/smart-farmer/runtime.env
# Confirm these loopback ports are unused on the target before selecting values.
FARMER_API_PORT=18131
FARMER_WEB_PORT=18132
# Only for a new, explicitly approved local database. Keep this file private.
FARMER_POSTGRES_USER=smart_farmer
FARMER_POSTGRES_DB=smart_farmer
FARMER_POSTGRES_PASSWORD=REPLACE_WITH_DEDICATED_RANDOM_PASSWORD
