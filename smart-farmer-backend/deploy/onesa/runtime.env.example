# Copy to an owner-only private file; unquoted assignments only. Never commit secrets.
# Dedicated local database example; replace the password with the matching private value.
PGHOST=db
PGPORT=5432
PGUSER=smart_farmer
PGPASSWORD=REPLACE_WITH_DEDICATED_RANDOM_PASSWORD
PGDATABASE=smart_farmer
DB_POOL_SIZE=5
