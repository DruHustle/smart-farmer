# Docker Compose reads this file; host Node processes need exported variables or --env-file.
POSTGRES_PASSWORD=replace-with-a-local-development-password
WEB_ORIGIN=http://localhost:5173
PORT=3000
HOST=127.0.0.1
# Host development alternative; URL-encode any special password characters.
DATABASE_URL=postgresql://smart_farmer:replace-with-url-encoded-password@127.0.0.1:5432/smart_farmer
TEST_DATABASE_URL=postgresql://smart_farmer:replace-with-url-encoded-test-password@127.0.0.1:5432/smart_farmer_test
MEDIA_ROOT=.data/media
MEDIA_FARM_QUOTA_BYTES=262144000
DB_POOL_SIZE=10
LOG_LEVEL=info
