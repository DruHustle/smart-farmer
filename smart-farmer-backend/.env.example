# Docker Compose reads this file; host Node processes need exported variables or --env-file.
POSTGRES_PASSWORD=replace-with-a-local-development-password
WEB_ORIGIN=http://localhost:5173
PORT=3000
HOST=127.0.0.1
# Host development alternative; URL-encode any special password characters.
DATABASE_URL=postgresql://smart_farmer:replace-with-url-encoded-password@127.0.0.1:5432/smart_farmer
TEST_DATABASE_URL=postgresql://smart_farmer:replace-with-url-encoded-test-password@127.0.0.1:5432/smart_farmer_test
MEDIA_ROOT=.data/media
MEDIA_FARM_QUOTA_BYTES=262144000
DB_POOL_SIZE=10
LOG_LEVEL=info

# Operational providers. Disabled until explicitly configured and farm-enabled.
MEDIA_PROVIDER=file
CAMERA_FARM_QUOTA_BYTES=524288000
# MEDIA_PROVIDER=s3
S3_BUCKET=
S3_ENDPOINT=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
WEATHER_PROVIDER=unconfigured
OPEN_METEO_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
NOTIFICATION_MODE=disabled
# Generate a separate 32-byte hex key; protect/backup it independently.
PROVIDER_SECRET_KEY=
RESEND_API_KEY=
NOTIFICATION_FROM=
EXPO_ACCESS_TOKEN=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
MARKET_MODERATOR_USER_IDS=
# Independent encrypted backup identity and destination; never reuse the media bucket.
BACKUP_ENABLED=false
BACKUP_KEY_FILE=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
RESTORE_ADMIN_DATABASE_URL=

# Recovery-only object storage: keep these in the separate recovery environment.
RESTORE_DATABASE_URL=
RESTORE_MEDIA_S3_BUCKET=
RESTORE_MEDIA_S3_REGION=
RESTORE_MEDIA_S3_ENDPOINT=
RESTORE_MEDIA_S3_ACCESS_KEY_ID=
RESTORE_MEDIA_S3_SECRET_ACCESS_KEY=
RESTORE_MEDIA_S3_SESSION_TOKEN=
